{
  "$comment": "启明星系统 · 领域地图（机器可读）。这是 ARCHITECTURE.md §5 的唯一权威来源：新增模块必须先登记到这里，scripts/audit_architecture.py 会强制校验。规则：① 领域之间互不重叠（MECE）；② 每个业务模块必须恰好属于一个领域；③ 跨领域调用只能通过对方 service 的公开方法（后端）/ feature 的 index.ts（前端，规划中）。",
  "schema_version": 1,
  "updated": "2026-11-01",
  "domains": {
    "platform": {
      "title": "平台底座",
      "responsibility": "认证、设置、安全、备份、同步、事件、健康检查、日志、通知、规则、插件。被所有领域依赖，不得反向依赖任何业务领域。",
      "modules": [
        "audit",
        "auth",
        "backup",
        "events",
        "health",
        "logs",
        "notification",
        "plugins",
        "rules",
        "security",
        "settings",
        "settings_history",
        "sync",
        "user"
      ]
    },
    "execution": {
      "title": "执行管理",
      "responsibility": "任务、项目、里程碑、工作流、工作区。『待办 → 项目 → 自动化』的完整执行链路。",
      "modules": [
        "project",
        "task",
        "workflow",
        "workspace"
      ]
    },
    "knowledge": {
      "title": "个人知识",
      "responsibility": "文档、文件夹、双向链接、学习与间隔重复、资源收集箱、模板、经验沉淀、复盘。",
      "modules": [
        "document",
        "domain",
        "experience",
        "flashcard",
        "folder",
        "learning",
        "resource",
        "review",
        "study_plan",
        "study_time",
        "template"
      ]
    },
    "growth": {
      "title": "个人成长",
      "responsibility": "成长状态与经验值、多重身份、生活记录（习惯/心情/四维日记）。",
      "modules": [
        "diary",
        "growth",
        "habit",
        "habit_checkin",
        "identity",
        "life",
        "mood"
      ]
    },
    "assistant": {
      "title": "AI 交互",
      "responsibility": "多轮对话、AI 助手、快捷指令面板、灵感与长期记忆、AI 信息源（插件）。唯一允许直接持有 LLM 客户端与提示词工程细节的领域。",
      "modules": [
        "assistant",
        "conversation",
        "panel"
      ]
    },
    "companion": {
      "title": "桌宠陪伴",
      "responsibility": "桌宠状态感知、动作、形象与头像管理、TTS 语音。",
      "modules": [
        "avatar",
        "pet"
      ]
    },
    "asset": {
      "title": "资产沉淀",
      "responsibility": "长期资产库（SOP/Prompt/Skill/项目记忆）与保险箱（加密凭据）。",
      "modules": [
        "asset",
        "project_memory",
        "prompt",
        "skill",
        "sop",
        "sop_version",
        "vault"
      ]
    },
    "insight": {
      "title": "数据洞察",
      "responsibility": "首页聚合仪表盘、报告生成。只读聚合，不拥有业务数据，不得写其他领域的表。",
      "modules": [
        "dashboard",
        "report"
      ]
    }
  },
