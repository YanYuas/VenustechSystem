# ============================================================
# 启明星系统 — 公网部署配置
# 复制此文件为 .env 并修改相应值
# ============================================================

# 允许所有来源（公网部署用 *，内网保留具体域名）
VENUSTECH_CORS_ORIGINS=*

# 后端端口（保持不变）
VENUSTECH_PORT=8765

# 是否灌演示数据
VENUSTECH_DEMO_SEED=true

# AI API Key（留空则使用 mock 模式）
# VENUSTECH_AI_API_KEY=sk-xxxx
