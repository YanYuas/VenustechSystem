# ============================================================
# 启明星系统 — 环境变量模板（唯一权威示例）
#
# 复制为 backend/.env 后按需修改；这里每个字段都对应 app/config.py
# 的 Settings 类。不要添加模板里没有、代码里也不存在的变量：
# Settings(extra="ignore") 会把它们静默丢弃，造成"我明明配了却不生效"。
#
# 变量前缀固定为 VENUSTECH_。
# 生产/公网部署请显式修改：DATA_DIR、DEMO_SEED、CORS_ORIGINS。
# ============================================================

# ---------- 运行 ----------
# 开发模式：True 时允许热重载
VENUSTECH_DEV=true
# 监听地址/端口。后端只应绑回环；对外由 ops/server/server.js 统一暴露。
VENUSTECH_HOST=127.0.0.1
VENUSTECH_PORT=8765

# ------------------------------------------------------------------
# 数据目录（最重要的一个变量）
# ------------------------------------------------------------------
# 所有运行期数据（app.db / logs / backups / documents / plugins /
# .encryption_key）都在这里。留空 = ./data（相对启动时的工作目录）——
# 从仓库根或其他目录启动会生成第二份数据库，因此务必显式写绝对路径。
# 约定：仓库内运行期数据统一放 var/（已被 .gitignore 整体忽略）。
#   VENUSTECH_DATA_DIR=D:\...\VenustechSystem\var\data
#   VENUSTECH_DATA_DIR=D:\...\VenustechSystem\var\demo
VENUSTECH_DATA_DIR=

# ---------- 日志 ----------
VENUSTECH_LOG_LEVEL=INFO

# ---------- 首次启动是否灌演示数据 ----------
# 空库 + 需要演示时才设 true；生产部署必须 false，否则真实库会被演示数据污染。
VENUSTECH_DEMO_SEED=false

# ---------- CORS ----------
# 逗号分隔的精确来源；不要用 *（带凭据的跨域请求不支持通配）。
VENUSTECH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://localhost,capacitor://localhost

# ---------- AI（DeepSeek / OpenAI 兼容端点） ----------
# 注意：AI 的 API Key 不在环境变量里。它按用户加密存库
# （users.api_key_encrypted，AES+HMAC，见 app/core/encryption.py），
# 由 App「设置 → AI」页写入。本文件只配置端点与模型。
VENUSTECH_AI_BASE_URL=https://api.deepseek.com/v1
VENUSTECH_AI_MODEL=deepseek-chat
VENUSTECH_AI_TIMEOUT=30.0
