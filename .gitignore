# ============================================================
# 说明：本文件必须自给自足。
# 曾出现的问题：backend/.venv（2163 个文件）与 backend/.pytest_cache
# 只被开发机的全局 ~/.gitignore_global 忽略 —— 换机器/换人执行
# `git add -A` 会把整个 venv 提交进仓库。以下规则补齐这一层。
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
venv/
.venv/
*.venv/
env/
.eggs/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.env
.env.*
!.env.example

# ---------- Node ----------
node_modules/
dist/
build/
*.tsbuildinfo
.vite/

# ---------- Android（Capacitor 构建产物；android/.gitignore 之外再兜一层） ----------
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/
frontend/android/local.properties
frontend/android/.idea/
*.apk
*.aab
*.keystore
!frontend/android/app/debug.keystore

# ---------- IDE ----------
.vscode/
.idea/
*.iml

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 ----------
*.log
logs/

# ---------- 运行期数据（避免切分支时覆盖本地数据库） ----------
# 目标约定：所有运行期数据都在 var/ 下（见 ARCHITECTURE.md §7）。
# 用 var/* + 例外保留 .gitkeep，这样目录结构进仓库、数据不进。
var/*
!var/.gitkeep
# 下面同时保留历史目录名，防止旧路径的数据被误提交。
data/
data-fusion/
data-*/
data_*/
backend/data/
backend/data_*/
backend/.smoke-tmp/
# var/ 迁移（2026-10-27）后旧数据目录原样改名保留，含 app.db/.encryption_key/logs；
# 确认迁移无误后可整个删掉。整目录忽略（仅靠 *.db 不足以覆盖 .encryption_key 等）。
backend/.legacy-data-*/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------- 审计/分析临时产物（不是项目源码） ----------
.arch-audit/
.pytest-tmp*/
.pytest-tmp/
.pytest-tmp2/
# pytest 的 basetemp 跟随 TMP/TEMP；本机 TMP 指向仓库根时会落在 backend/ 下
pytest-of-*/
backend/pytest-of-*/
tmp?????????/
backend/venustech_smoke/
backend/tmp*/
backend/.arch-audit-x/

# ---------- 本地工作区垃圾（结构契约见 scripts/audit_workspace_hygiene.py） ----------
# 说明：var/* 已经覆盖整个 var/，下面几条是"显式声明"——审计与后来者一眼能看出
# 哪些目录是"可随时删除的本地垃圾"，而不是被一条通配符默默吞掉。
# --fix-local 只清理这一节的模式（以及 var/ 顶层散落文件），绝不碰 data/demo/legacy/backups。
var/pytest-*/
var/pytest-basetemp/
var/.ruff-*/
var/rebuild/
var/tools/
var/junk/
var/probe-ps/
var/sandbox_patch/


# ---------- 本地工具状态（智能体记忆/会话数据，非项目源码） ----------
.workbuddy/
.claude/

# ---------- 密钥与令牌（绝不入库） ----------
.qm-token
*.pem
*.key

# ---------- 测试覆盖率产物（pytest-cov / vitest；测试产物，可安全删除） ----------
# 为什么显式写：后台并行 pytest-cov 会在 backend/ 生成一堆 .coverage.<machine>.<pid>.<rand>，
# vitest --coverage 会生成 frontend/coverage/。它们默认不在 git 跟踪里，但没人忽略时
# 一次 `git add -A` 就会入库（而且体积不小）。
.coverage
.coverage.*
coverage/
coverage.xml
htmlcov/

# ---------- 临时文件（构建/调试/提交信息） ----------
backend/smoke_out.txt
backend/.ck.txt
backend/.ck2.txt
backend/run_out.txt
build_out.txt
srv.txt
frontend/.tq.mjs
frontend/.tc.mjs
.tc.mjs
.tq.mjs
.git-commit-msg.tmp
*.tmp
backend/seed_out.txt
backend/verify_out.txt
backend/api_out.txt
backend/data_demo/
