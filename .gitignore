# ============================================================
# 说明：本文件必须自给自足。
# 曾出现的问题：backend/.venv（2163 个文件）与 backend/.pytest_cache
# 只被开发机的全局 ~/.gitignore_global 忽略 —— 换机器/换人执行
# `git add -A` 会把整个 venv 提交进仓库。以下规则补齐这一层。
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
venv/
.venv/
*.venv/
env/
.eggs/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.env
.env.*
!.env.example

# ---------- Node ----------
node_modules/
dist/
build/
*.tsbuildinfo
.vite/

# ---------- Android（Capacitor 构建产物；android/.gitignore 之外再兜一层） ----------
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/
frontend/android/local.properties
frontend/android/.idea/
*.apk
*.aab
*.keystore
!frontend/android/app/debug.keystore

# ---------- IDE ----------
.vscode/
.idea/
*.iml

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 ----------
*.log
logs/

# ---------- 运行期数据（避免切分支时覆盖本地数据库） ----------
# 目标约定：所有运行期数据都在 var/ 下（见 ARCHITECTURE.md §7）。
# 用 var/* + 例外保留 .gitkeep，这样目录结构进仓库、数据不进。
var/*
!var/.gitkeep
# 下面同时保留历史目录名，防止旧路径的数据被误提交。
data/
data-fusion/
data-*/
data_*/
backend/data/
backend/data_*/
backend/.smoke-tmp/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------- 审计/分析临时产物（不是项目源码） ----------
.arch-audit/
.pytest-tmp*/
.pytest-tmp/
.pytest-tmp2/
# pytest 的 basetemp 跟随 TMP/TEMP；本机 TMP 指向仓库根时会落在 backend/ 下
pytest-of-*/
backend/pytest-of-*/
tmp?????????/
backend/venustech_smoke/

# ---------- 本地工具状态（智能体记忆/会话数据，非项目源码） ----------
.workbuddy/
.claude/

# ---------- 密钥与令牌（绝不入库） ----------
.qm-token
*.pem
*.key

# ---------- 临时文件（构建/调试/提交信息） ----------
backend/smoke_out.txt
backend/.ck.txt
backend/.ck2.txt
backend/run_out.txt
build_out.txt
srv.txt
frontend/.tq.mjs
frontend/.tc.mjs
.tc.mjs
.tq.mjs
.git-commit-msg.tmp
*.tmp
backend/seed_out.txt
backend/verify_out.txt
backend/api_out.txt
backend/data_demo/
